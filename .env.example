# TravelMCP — пример окружения. Скопируйте в .env и заполните секреты.
# Приоритет env > .env > YAML. Префикс TRAVELMCP__ для вложенных ключей (см. docs/10-observability.md).
# Не коммитьте .env с реальными ключами.

# HTTP
HTTP_ADDR=:8080
# TRAVELMCP__HTTP__RATE_LIMIT__RPS=100
# TRAVELMCP__HTTP__RATE_LIMIT__BURST=200
# HTTP_RATE_LIMIT_RPS=100
# HTTP_RATE_LIMIT_BURST=200

# Store / Database (единая точка — store; database — legacy alias)
# memory (тесты/dev): memory | sqlite файл: sqlite://./data/travelmcp.db | postgres: postgres://user:pass@localhost:5432/travelmcp?sslmode=disable
DATABASE_DSN=
# TRAVELMCP__STORE__DSN=sqlite://./data/travelmcp.db
# TRAVELMCP__STORE__KIND=memory
# TRAVELMCP__CACHE__KIND=memory
# TRAVELMCP__CACHE__TTL=5m
# TRAVELMCP__QUEUE__KIND=memory

# Providers
PROVIDERS_ENABLED=
# intercity: PROVIDERS_ENABLED=intercity (нужен data/reestr/regions.json)
# synth demo: PROVIDERS_ENABLED=synth
INTERCITY_REESTR_PATH=data/reestr/regions.json
# TRAVELMCP__PROVIDERS__ENABLED=synth,intercity

# Planner
PLANNER_ENGINE=csa
# PLANNER_SEMAPHORE_SIZE=0
# PLANNER_SEMAPHORE_ENABLE=true
# TRAVELMCP__PLANNER__SEMAPHORE_SIZE=8

# Auth
ADMIN_TOKEN=dev-secret
# TRAVELMCP__AUTH__ADMIN_TOKEN=dev-secret

# Geocoder — приоритет по умолчанию nominatim (OSM, бесплатно) -> yandex.
# kind не обязателен (пусто = nominatim first); при недоступности — фолбэк, 3 попытки.
# yandex: YANDEX_GEOCODE_KEY + YANDEX_GEOCODE_URL; nominatim: NOMINATIM_URL
GEOCODER_KIND=
GEOCODER_API_KEY=
GEOCODER_BASE_URL=
GEOCODER_ATTEMPTS=3
NOMINATIM_URL=https://nominatim.openstreetmap.org
# TRAVELMCP__GEOCODER__KIND=
# TRAVELMCP__GEOCODER__API_KEY=
# TRAVELMCP__GEOCODER__URL=
# TRAVELMCP__GEOCODER__ATTEMPTS=3
# TRAVELMCP__NOMINATIM__URL=https://nominatim.openstreetmap.org
# aliases: GEOCODER_KEY, GEOCODER_URL, YANDEX_GEOCODE_KEY (legacy)

# Yandex Rasp (отдельно от геокодера) + Geocode (fallback)
YANDEX_RASP_KEY=
YANDEX_GEOCODE_KEY=
YANDEX_GEOCODE_URL=https://geocode-maps.yandex.ru/1.x

# Log
LOG_LEVEL=info
LOG_FORMAT=json
# LOG_ADD_SOURCE=false
# TRAVELMCP__LOG__LEVELS__STORE=debug
# TRAVELMCP__LOG__LEVELS__PROVIDERS_INTERCITY=debug

# Telemetry
# TRAVELMCP__TELEMETRY__PROMETHEUS_ADDR=:9090
